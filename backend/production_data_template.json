        "status": "ACTIVE",
        "date": "YYYY-MM-DD",
        "createdAt": 0
      }
    ]
  },
  "realtime_database": {
    "users": {
      "$comment": "RTDB path: /users/{uid}. Required for RTDB security rules to authorize Driver tracking and Admin bypass.",
      "FIREBASE_AUTH_UID_ADMIN": {
        "role": "ADMIN",
        "active": true,
        "customId": "PROD_ADMIN_ID",
        "name": "Official Admin Full Name"
