            "latitude": 0.0,
            "longitude": 0.0,
            "order": 1
          }
        ],
        "schedules": {
          "morning": {
            "startTime": "07:00",
            "endTime": "09:00",
            "enabled": true
          },
          "evening": {
            "startTime": "16:00",
            "endTime": "18:00",
            "enabled": true
          }
        }
      }
    ],
    "bus_swaps": [
      {
        "$comment": "Temporary bus substitution record (created by Driver or Admin). Document ID: {swapId}",
        "swapId": "SWAP_ID",
        "originalBusId": "PROD_BUS_ID_ORIGINAL",
        "replacementBusId": "PROD_BUS_ID_REPLACEMENT",
        "routeId": "PROD_ROUTE_ID",
        "driverId": "FIREBASE_AUTH_UID_DRIVER",
