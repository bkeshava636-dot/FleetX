{
  "$comment": "PRODUCTION DATA TEMPLATE FOR COLLEGE BUS TRACKING SYSTEM. Do not load mock or test data into production. Populate with verified college transport data.",
  "firestore": {
    "users": [
      {
        "$comment": "Admin User Profile. Document ID must match the Firebase Authentication UID.",
        "id": "FIREBASE_AUTH_UID_ADMIN",
        "customId": "PROD_ADMIN_ID",
        "email": "PROD_ADMIN_ID@collegebus.internal",
        "name": "Official Admin Full Name",
        "role": "ADMIN",
        "assignedBusId": null,
        "active": true,
        "createdAt": 0
      },
      {
        "$comment": "Driver User Profile. Document ID must match the Firebase Authentication UID.",
        "id": "FIREBASE_AUTH_UID_DRIVER",
        "customId": "PROD_DRIVER_ID",
        "email": "PROD_DRIVER_ID@collegebus.internal",
        "name": "Official Driver Full Name",
        "role": "DRIVER",
        "assignedBusId": "BUS_DOCUMENT_ID",
        "active": true,
        "createdAt": 0
      }
    ],
    "buses": [
