        "active": true,
        "customId": "PROD_DRIVER_ID",
        "name": "Official Driver Full Name"
      }
    },
    "live_locations": {
      "$comment": "RTDB path: /live_locations/{busId}. Holds only latest real-time GPS coordinate per bus.",
      "PROD_BUS_ID": {
        "busId": "PROD_BUS_ID",
        "latitude": 0.0,
        "longitude": 0.0,
        "speed": 0.0,
        "bearing": 0.0,
